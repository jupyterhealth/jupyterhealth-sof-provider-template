# Example fly.io deploy config. Copy to fly.toml and adjust.
app = "your-provider-app"
primary_region = "sjc"

[build]
  dockerfile = "Dockerfile"

# Sessions live in memory: keep this app on ONE machine (fly scale count 1).
[http_service]
  internal_port = 8888
  force_https = true
  auto_stop_machines = true
  min_machines_running = 1

[[vm]]
  memory = "1gb"
  cpus = 1
